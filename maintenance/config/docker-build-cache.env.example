# Example Docker build cache cleanup environment.
#
# Real config path:
# /etc/the-hub-maintenance/docker-build-cache.env
#
# Generated .prom files are written here by maintenance scripts and read by
# node_exporter textfile collector.

DOCKER_BUILD_CACHE_METRICS_DIR=/var/lib/node_exporter/textfile_collector
DOCKER_BUILD_CACHE_LOCK_FILE=/tmp/the-hub-docker-build-cache-cleanup.lock
