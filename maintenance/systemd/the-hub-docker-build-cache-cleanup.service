[Unit]
Description=the-hub Docker build cache cleanup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/katrin/projects/the-hub-infra
EnvironmentFile=-/etc/the-hub-maintenance/docker-build-cache.env
ExecStart=/home/katrin/projects/the-hub-infra/maintenance/scripts/cleanup-docker-build-cache.sh
UMask=0022
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
