# Example backup environment.
#
# Real config path:
# /etc/the-hub-backup/backup.env
#
# Uptime Kuma push URL must not be stored in Git.
# Store the URL itself in a separate local file referenced below.
# PostgreSQL and SQLite use separate Push monitors.

POSTGRES_BACKUP_DIR=/srv/backups/staging/postgres
POSTGRES_RETENTION_DAYS=14
POSTGRES_MAX_BACKUP_AGE_HOURS=26
BACKUP_LOCK_FILE=/tmp/the-hub-postgres-backup.lock
SQLITE_BACKUP_DIR=/srv/backups/staging/sqlite
SQLITE_MAX_BACKUP_AGE_HOURS=26
SQLITE_BACKUP_LOCK_FILE=/tmp/the-hub-sqlite-backup.lock
KUMA_PUSH_URL_FILE=/etc/the-hub-backup/kuma-push-url
SQLITE_KUMA_PUSH_URL_FILE=/etc/the-hub-backup/kuma-sqlite-push-url
