[Unit]
Description=the-hub PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=katrin
Group=katrin
WorkingDirectory=/home/katrin/projects/the-hub-infra
EnvironmentFile=-/etc/the-hub-backup/backup.env
ExecStart=/home/katrin/projects/the-hub-infra/backup/scripts/backup-postgres.sh

[Install]
WantedBy=multi-user.target
